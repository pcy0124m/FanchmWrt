# FanchmWrt 配置种子（京东云无线宝一代 亚瑟 RE-SP-01B / MT7621）
# 交付 make defconfig 展开为完整 .config

# 目标平台
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# 固件格式
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 基础界面（LuCI 中文）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-compat=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils-nohup=y

# 存储支持（设备带 eMMC + USB2.0）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# 网络增强
CONFIG_PACKAGE_wg-tools=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y

# DDNS（远程访问常用）
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y

# WiFi 驱动（MT7603EN + MT7615N，mt76 已默认，显式确认）
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# 品牌信息（依赖链：IMAGEOPT -> VERSIONOPT -> VERSION_DIST，少一个整块失效）
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="FanchmWrt"
CONFIG_VERSION_NICK="fanchm"
CONFIG_VERSION_PRODUCT="FanchmWrt RE-SP-01B"
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12.2"
CONFIG_VERSION_BUG_URL="https://github.com/pcy0124m/FanchmWrt/issues"

# 主题：Argon（由 workflow 从 jerrykuku 仓库拉取）及其配置页
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
